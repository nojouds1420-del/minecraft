# Copy this file to .env and fill in your own values.

# Get a free development key from https://developer.hypixel.net/dashboard/
# (log in, "Create Development Key", then create an app and copy its key).
# Only used for the public-server demo -- not needed once you switch to
# reading from your own private server's plugin/database.
HYPIXEL_API_KEY=

# Any Java Edition server address, with or without a port (e.g. "play.example.com"
# or "play.example.com:25566"). Defaults to mc.hypixel.net for the demo.
# Point this at the celebrity's private server once it exists.
MC_SERVER_ADDRESS=bedrock.veinmc.com

PORT=5000
FLASK_DEBUG=1
